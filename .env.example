# ═══ WA Status · configuração local (.env) ═══════════════════════════════════
# 1) Copie este arquivo:   cp .env.example .env
# 2) Preencha os valores ABRINDO O .env NO EDITOR (nunca cole a chave no chat do Claude).
# 3) O .env nunca vai para o git (já está no .gitignore). Permissão recomendada: chmod 600 .env
# Na nuvem do Claude Code, as MESMAS variáveis vão no "ambiente" da rotina.

# ─── Servidor WAHA (comum a todos os produtos) ───────────────────────────────
WAHA_BASE_URL=                 # ex.: https://waha.seudominio.com.br (sem barra no fim)
WHATSAPP_API_KEY=              # a chave da API do seu WAHA (o valor puro, não o hash sha512:)

# ─── Quais produtos estão ligados (ids das pastas em produtos/, separados por vírgula)
PRODUTOS_ATIVOS=               # ex.: meuproduto

# ─── Um bloco por produto. O PREFIXO é o env_prefixo do produtos/<id>/produto.yaml
# Sessão WAHA conectada ao número que PUBLICA os status deste produto:
MEUPRODUTO_WAHA_SESSION=       # ex.: default
# WhatsApp de quem APROVA as prévias (precisa ser DIFERENTE do número que publica):
MEUPRODUTO_APPROVER_CHAT_ID=   # formato 55DDDNUMERO@c.us, ex.: 5511900000000@c.us

# ─── Modo teste: 1 = os status vão só para o aprovador (use até tudo estar conferido)
WASTATUS_TESTE=1
